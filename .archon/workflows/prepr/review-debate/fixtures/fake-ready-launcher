#!/usr/bin/env bun
import { appendFileSync } from 'node:fs';
const prompt = process.argv.find(arg => arg.startsWith('PREPR_READINESS:') || arg.startsWith('You are one side') || arg.startsWith('Continue the same')) || process.argv.at(-1) || '';
if(process.argv.includes('--version')){console.log('1.3.14');process.exit(0);}
const log = process.env.PREPR_TEST_LOG;
const probe = prompt.startsWith('PREPR_READINESS:');
if (log) appendFileSync(log, JSON.stringify({probe,args:process.argv.slice(2)})+'\n');
if (process.env.PREPR_TEST_DELAY) await Bun.sleep(Number(process.env.PREPR_TEST_DELAY));
const output = (text) => {
 if (process.argv.includes('--json')) {
  console.log(JSON.stringify({type:'thread.started',thread_id:'fixture-session'}));
  console.log(JSON.stringify({type:'item.completed',item:{type:'agent_message',text}}));
 } else console.log(JSON.stringify({type:'result',session_id:'fixture-session',result:text}));
};
if (probe) { console.error('Unexpected readiness AI session');process.exit(2); } else if (process.env.PREPR_TEST_REVIEW_FAIL) { console.error('Authentication expired or selected model unavailable.'); process.exit(1); }
else if (process.env.PREPR_TEST_ACCEPTANCE) {
 if (process.argv.includes('resume') || process.argv.includes('--resume')) {
  const source=prompt.match(/attributed finding: (\[.*?\])\. The other/);
  const current=JSON.parse(source?.[1] || '[]').map(f=>f.id);
  const candidates=prompt.match(/different failures: (\[.*?\])\. Also return/);
  const ids=JSON.parse(candidates?.[1] || '[]').map(f=>f.id).filter(id=>!current.includes(id));
  output(JSON.stringify({stance:'accept',verdict:'issue',rationale:'Anonymous requests crash if the user is missing. Duplicate-date data remains unverified.',sameConcernAs:ids}));
 } else {
  const a=process.argv.includes('--json');
  output(JSON.stringify({findings:[{summary:a?'missing request guard':'anonymous request crashes',file:'a.ts',line:1,severity:a?'P1':'Must fix',verdict:'issue',evidence:'Anonymous requests crash if the user is missing. Duplicate-date data remains unverified.'}],verification:[{name:'Tests',status:'not run',evidence:'Controlled fixture; no project tests executed.'}]}));
 }
} else output('{"findings":[],"verification":"Tests not run; fixture review only."}');
